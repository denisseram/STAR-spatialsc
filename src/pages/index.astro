---
import Layout from "../layouts/Layout.astro";
import FigureGrid from "../components/FigureGrid.jsx";
import {
  loadQuotations,
  loadCodeMap,
  loadSourceMap,
  extractFigureData,
  normalizeBaseUrl
} from "../lib/dataLoader.js";

// Load data at build time
const quotations = loadQuotations();
const codeMap = loadCodeMap();
const sourceMap = loadSourceMap();

// Normalize base URL for image paths
const baseUrl = normalizeBaseUrl(import.meta.env.BASE_URL);

// Extract figure data with all metadata
const figuresData = extractFigureData(quotations, codeMap, sourceMap, baseUrl);
---

<Layout>
  <FigureGrid client:load figures={figuresData} />
</Layout>

